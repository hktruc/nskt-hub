{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // Bản chạy của khóa "Hành trình 45N · Gắn kết & Nâng tầm đội ngũ" K02 (cộng đồng dh3g 47), dùng chung mã nguồn với nskt-hub.
  // Triển khai: npx wrangler deploy -c courses/45n-k2/wrangler.jsonc  →  45n-hub.<tài-khoản>.workers.dev
  "name": "45n-hub",
  "main": "../../src/index.tsx",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "alias": { "@course": "./course.ts" },
  "assets": { "directory": "./public" },
  "preview_urls": false,
  "observability": { "enabled": true },
  "vars": {
    "APP_NAME": "45n-hub",
    "DH3G_BASE_URL": "https://api.dh3g.vn",
    "DH3G_COMMUNITY_ID": "47",
    "SYNC_START_DATE": "2026-11-09",
    "OPENAI_MODEL": "gpt-5-nano",
    "OPENAI_REASONING_EFFORT": "minimal",
    // Cloudflare Access (không phải bí mật) chỉ khóa /quan-tri: ứng dụng "45n-hub - quan-tri", chỉ email chủ dự án.
    // Chủ dự án vào /quan-tri qua Access (là admin), tạo tài khoản số điện thoại cho mình, BTC và trưởng nhóm.
    "ACCESS_TEAM_DOMAIN": "hidden-art-d8b9.cloudflareaccess.com",
    "ACCESS_AUD": "837bbf85559b7e395d029fb69a5ae9e7963983b76933f3d81c2a12234f0d0679"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "45n-hub-db",
      // Tạo ngày 16/11/2026 (chủ dự án đồng ý); dữ liệu riêng, không lẫn với NSKT.
      "database_id": "d974a11a-13a3-4f17-8674-1f3f46fe6d60",
      "migrations_dir": "../../migrations"
    }
  ],
  "triggers": { "crons": ["15 0 * * *", "*/5 * * * *"] }
  // Khóa dh3g là secret DH3G_API_KEY nhập riêng cho worker này (cùng giá trị với NSKT).
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Worker mới, tách hẳn khỏi các worker long-mon-* cũ.
  "name": "nskt-hub",
  "main": "src/index.tsx",
  "compatibility_date": "2026-11-01",
  // Chạy ở địa chỉ miễn phí nskt-hub.<tài-khoản>.workers.dev (chủ dự án chọn 11/11/2026).
  // Trang nội bộ khóa bằng Cloudflare Access; /bang-xep-hang để công khai.
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "vars": {
    "APP_NAME": "nskt-hub",
    "DH3G_BASE_URL": "https://api.dh3g.vn",
    "DH3G_COMMUNITY_ID": "44",
    "SYNC_START_DATE": "2026-09-23",
    // AI chấm bài: mô hình OpenAI rẻ nhất vừa đủ. Khóa nhập riêng làm secret OPENAI_API_KEY.
    "OPENAI_MODEL": "gpt-5-nano",
    "OPENAI_REASONING_EFFORT": "minimal",
    // Google Sheet điểm danh offline (CHECK_IN) và danh sách chia thôn (DS_CHIA_THON). Chỉ là id file,
    // muốn đọc được phải chia sẻ quyền xem cho tài khoản dịch vụ (secret GOOGLE_SERVICE_ACCOUNT_JSON).
    "SHEET_ATTENDANCE_ID": "12nRGFRi67UkqFmzSZ7d6favIgxLp0ucyuyAH9vDMxYE",
    "SHEET_ROSTER_ID": "1REe5rdJTf4BZVx03LCVwhrX81LQuLq9uaqHfLx8VuBg",
    // Cloudflare Access (không phải bí mật): ứng dụng "nskt-hub - Cloudflare Workers".
    "ACCESS_TEAM_DOMAIN": "hidden-art-d8b9.cloudflareaccess.com",
    "ACCESS_AUD": "cd04f88badc957f8cecaefefb0e646276500084e90c67baf5557c0eb9070133c"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nskt-hub-db",
      // Tạo ngày 11/11/2026 (đã có đủ bảng 0001, 0002).
      "database_id": "66754a8e-7e74-4f88-aea9-bbd4c75b65fd",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": [
      "15 0 * * *", // 07:15 giờ Việt Nam: lên kế hoạch lấy dữ liệu trong ngày
      "*/5 * * * *" // mỗi 5 phút: xử lý vài việc trong hàng đợi (trống thì không làm gì)
    ]
  }
  // Khóa dh3g KHÔNG đặt ở đây: nhập dưới dạng secret DH3G_API_KEY trên Cloudflare.
}
